{
	"manifest_version": 3,

"content_security_policy": {
  "extension_pages": "default-src 'self'"
},

	"name": "url text list maker",
	"description": "url text list maker",
	"version": "2.0",

"permissions": [
  "tabs",
  "bookmarks",
  "storage"
],

	"host_permissions": ["<all_urls>","http://*/*","https://*/*"],


	"action": {
		"default_icon": "icon.png",
		"default_title": "url text list",
		"default_popup": "popup.html"
	}

}