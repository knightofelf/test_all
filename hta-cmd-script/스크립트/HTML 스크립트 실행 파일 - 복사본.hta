  <style>
    body {
      font-family: 'Segoe UI', sans-serif;
      padding: 30px;
      background-color: #f4f4f4;
    }
    #drop-zone {
      width: 500px;
      height: 150px;
      border: 4px dashed #0078D7;
      background-color: #e6f0ff;
      text-align: center;
      line-height: 140px;
      font-size: 18px;
      color: #0078D7;
      font-weight: bold;
      margin-bottom: 20px;
      transition: background-color 0.3s ease;
    }
    #drop-zone:hover {
      background-color: #d0e7ff;
      cursor: pointer;
    }
    #output {
      font-size: 16px;
      color: #333;
      background-color: #fff;
      padding: 10px;
      border: 1px solid #ccc;
      width: 500px;
    }
  </style>



  <h2>📁 파일을 드래그 앤 드롭하세요</h2>
  <div id="drop-zone">
    여기로 파일을 드래그하세요
  </div>
  <div id="output">파일 이름이 여기에 표시됩니다</div>



<script language="javascript">
    var dropZone = document.getElementById("drop-zone");
    var output = document.getElementById("output");


      dropZone.ondragover = function(e) {
        if (e && e.preventDefault) e.preventDefault();
      };

      dropZone.ondrop = function(e) {
        if (!e || !e.dataTransfer) {
          output.innerHTML = "❌ 이벤트 객체가 올바르지 않습니다.";
          return;
        }

        e.preventDefault();

        var path = e.dataTransfer.getData("Text");
        if (!path || path.length === 0) {
          output.innerHTML = "❌ 경로를 인식하지 못했습니다.";
          return;
        }


      output.innerHTML = "📄 드래그된 파일들:<br>";

      for (var i = 0; i < files.length; i++) {
        output.innerHTML += "• " + files[i].name + "<br>";
      }
  };


  </script>




<div id="drop-zone1" ondrop="javascript:drop(event)" ondragover="javascript:allowDrop(event)">
  <p>여기로 드래그하세요</p>
</div>

<div id="drag-item" draggable="true" ondragstart="javascript:drag(event)">
  📦 드래그할 박스
</div>



<style>
#drop-zone1 {
  width: 300px;
  height: 200px;
  border: 2px dashed #aaa;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 20px;
}

#drag-item {
  width: 100px;
  height: 100px;
  background-color: #4CAF50;
  color: white;
  text-align: center;
  line-height: 100px;
  cursor: grab;
}
</style>


<script language="javascript">

function allowDrop(event) {
  event.preventDefault();
}

function drag(event) {
  event.dataTransfer.setData("text", event.target.id);
}

function drop(event) {
  event.preventDefault();
//  const data = event.dataTransfer.getData("text");
//  const draggedElement = document.getElementById(data);
  var data = event.dataTransfer.getData("text");
  var draggedElement = document.getElementById(data);
  event.target.appendChild(draggedElement);
}

</script>





<div id="drag-box" style="width:100px;height:100px;background:#4CAF50;position:absolute; left:300px; top:100px;"></div>


<script language="javascript">
var box = document.getElementById("drag-box");
var isDragging = false;

box.onmousedown = function(e) {
  isDragging = true;
  offsetX = e.clientX - box.offsetLeft;
  offsetY = e.clientY - box.offsetTop;
};

document.onmousemove = function(e) {
  if (isDragging) {
    box.style.left = (e.clientX - offsetX) + "px";
    box.style.top = (e.clientY - offsetY) + "px";
  }
};

document.onmouseup = function() {
  isDragging = false;
};


  function moveBox(x, y) {
    var box = document.getElementById("drag-box");
    box.style.left = x + "px";
    box.style.top = y + "px";
  }

  moveBox(300, 200); // x=200, y=150 위치로 이동


</script>



