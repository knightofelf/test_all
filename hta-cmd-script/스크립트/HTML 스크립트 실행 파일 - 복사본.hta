  <script type="text/javascript">
    function runPowerCfg() {
      try {
        var shell = new ActiveXObject("WScript.Shell");
        var exec = shell.Exec("powercfg.exe /a");
        var output = "";

        while (!exec.StdOut.AtEndOfStream) {
          var line = exec.StdOut.ReadLine();
          output += line + "<br>";
        }

        document.getElementById("result").innerHTML = output;
      } catch (e) {
        alert("실행 오류: " + e.message);
      }
    }
  </script>

  <button onclick="runPowerCfg()">절전 확인</button>
  <div id="result" style="margin-top:10px; font-family:monospace;"></div>



