<div class="dropdown" id="drop-zonex" style="position: absolute; margin-top:10px; font-family:monospace;">
  <button class="main-button">노트</button>
</div>

<div id="dynamicMenu" class="menu">
    <button onclick="runNOTEPAD 'J:\heroes\문서.txt' ">문서</button>
    <button onclick="runNOTEPAD 'J:\heroes\생각 낙서 노트.txt' ">생각 낙서 노트</button>
    <button onclick="runNOTEPAD 'J:\heroes\오늘의 지출.txt' ">오늘의 지출</button>
    <button onclick="runNOTEPAD 'J:\heroes\아이디어 사업화 노트.txt' ">아이디어 사업화</button>
</div>






<script language="JavaScript">  
var menu1_open = false;
var menu2_open = false;


  var dropZone = document.getElementById('drop-zonex');
//  var submenu = dropZone.getElementsByTagName('div')[0]; // 첫 번째 <div>가 submenu라고 가정
  var dynamicMenu = document.getElementById('dynamicMenu');
//  var submenu2 = document.getElementById('submenu2');
  var body = document.getElementById('body');
 

      dropZone.style.left = 50 + 'px';
      dropZone.style.top = 10 + 'px';




  // 버튼 OVER
  dropZone.attachEvent ? dropZone.attachEvent('onmouseover', function() {

      var rect = dropZone.getBoundingClientRect();
      var scrollTop = document.documentElement.scrollTop || document.body.scrollTop;


      // 해당 버튼 위에 메뉴 위치
      dynamicMenu.style.left = rect.left + 'px';
      dynamicMenu.style.top = rect.top + scrollTop + 35 + 'px'; //(rect.top + scrollTop - dynamicMenu.offsetHeight - 5) + 'px';

    //
    menu1_open = true;
    dynamicMenu.style.display = 'block';

//        document.getElementById("result").innerHTML += " 버튼 OVER   ";


  // 버튼 ENTER
  }) : dropZone.addEventListener('mouseenter', function() {
    dynamicMenu.style.display = 'block';
  });


  // 버튼 OUT
  dropZone.attachEvent ? dropZone.attachEvent('onmouseout', function() {

    menu1_open = false;
    setTimeout( fn_menu_close , 200 );

  // 버튼 LEAVE
  }) : dropZone.addEventListener('mouseleave', function() {

    menu1_open = false;
    setTimeout( fn_menu_close , 200 );

  });




// 메뉴 ENTER
dynamicMenu.onmouseenter = function() {
    menu2_open = true;


};

// 메뉴 OUT : 내부 버튼도 OUT 으로 적용됨
dynamicMenu.onmouseout = function() {

};

// 메뉴 LEAVE
dynamicMenu.onmouseleave = function() {
    menu2_open = false;
    dynamicMenu.style.display = 'none';


//    setTimeout( fn_menu_close , 3000 );
};


function fn_menu_close ( )
{
    if( menu1_open == true )
    {
	return ;
    }
    if( menu2_open == true )
    {
	return ;
    }
    menu1_open = false;
    menu2_open = false;
    dynamicMenu.style.display = 'none';
}

// setTimeout( fn_menu_close , 3000 );

</script>












  <script language="javascript">


function saveText() 
{
    var text = document.getElementById("textArea").value;
    saveAsUTF8(text, "D:\\ICS\\saved_text.txt") 
    return ;
}



    function loadText() 
    {

var path = "D:\\ICS\\saved_text.txt";
var text = readUTF8(path);
if (text !== null) {
//  alert("읽은 내용:\n" + text);
    document.getElementById("textArea").value = text;
}

    }


    function clearText() 
    {
        document.getElementById("textArea").value = "";
    }


  </script>







<table>
  <tr>
    <td><h3 style="margin: 0;">텍스트 입력</h3></td>
    <td><button onclick="saveText()">저장</button></td>
    <td><button onclick="loadText()">불러오기</button></td>
    <td><button onclick="clearText()">초기화</button></td>
  </tr>
</table>




<script language="javascript">


function saveAsUTF8(text, path) {
  try {
    var stream = new ActiveXObject("ADODB.Stream");
    stream.Type = 2; // 텍스트 모드
    stream.Charset = "utf-8"; // UTF-8 인코딩
    stream.Open();
    stream.WriteText(text);
    stream.SaveToFile(path, 2); // 2 = 덮어쓰기
    stream.Close();
    alert("UTF-8로 저장 완료!");
  } catch (e) {
    alert("오류 발생: " + e.message);
  }
}



function readUTF8(path) {
  try {
    var stream = new ActiveXObject("ADODB.Stream");
    stream.Type = 2; // 텍스트 모드
    stream.Charset = "utf-8"; // UTF-8 인코딩
    stream.Open();
    stream.LoadFromFile(path);
    var content = stream.ReadText();
    stream.Close();
    return content;
  } catch (e) {
    alert("읽기 오류: " + e.message);
    return null;
  }
}


</script>


  <textarea id="textArea" rows="10" cols="50"  maxlength="100000"></textarea><br><br>

  <div id="result" style="position: absolute; margin-top:10px; font-family:monospace;"></div>



<script language="javascript">
  var result = document.getElementById('result');
  result.style.left = 35;
  result.style.top = 100;

  loadText();
  document.getElementById("result").value = "정상 시작";

</script>



</body>
